<Window x:Class="Bayanov_Shoes.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Bayanov_Shoes"
        mc:Ignorable="d"
        Title="OrderWindow" Height="450" Width="800" FontFamily="Comic Sans MS">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Дата формирования заказа" FontSize="20" Width="240"></TextBlock>
                    <DatePicker Name="OrderDP" SelectedDateFormat="Short" Width="500" IsEnabled="False"></DatePicker>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Дата доставки заказа" FontSize="20" Width="240"></TextBlock>
                    <DatePicker Name="DeliveryDP" SelectedDateFormat="Short" Width="500" IsEnabled="False"></DatePicker>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ФИО клиента" FontSize="20" Width="240"/>
                    <TextBlock Name="FIOTB" Text="Гость" FontSize="20"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Номер заказа" FontSize="20" Width="240"/>
                    <TextBlock Name="OrderNumberTB" FontSize="20"/>
                </StackPanel>
            </StackPanel>

            <ListView Name="OrderListView" Margin="5" HorizontalContentAlignment="Stretch" Grid.Row="1">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Image Grid.Column="0" Grid.Row="0" Grid.RowSpan="4" Stretch="Uniform">
                                    <Image.Source>
                                        <Binding Path="ProductPhotoPathFull"/>
                                    </Image.Source>
                                </Image>
                                <TextBlock Style="{StaticResource MyStyle}" Text="{Binding ProductName}" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProductDescription}" TextWrapping="Wrap" Margin="0,5,0,0" VerticalAlignment="Top" FontSize="22"/>
                                <TextBlock Style="{StaticResource MyStyle}" Text="{Binding ProductManufacturer}" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Left"/>
                                <StackPanel Grid.Column="1" Grid.Row="3" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource MyStyle}" Text="{Binding ProductCost, StringFormat='{}{0} руб.'}" HorizontalAlignment="Left"/>
                                    <Button Name="BtnMinus" Content="-" Height="30" Width="30" VerticalContentAlignment="Center" Click="BtnMinus_Click"/>
                                    <TextBlock Text="{Binding ProductQuantity}" FontSize="20" VerticalAlignment="Center"/>
                                    <Button Name="BtnPlus" Content="+" Height="30" Width="30" VerticalContentAlignment="Center" Click="BtnPlus_Click"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource MyStyle}" Text="Скидка" Grid.Column="2" Grid.Row="0"/>
                                <TextBlock Text="{Binding ProductDiscountAmountInt, StringFormat='{}{0} %'}" Grid.Column="2" Grid.Row="1" Grid.RowSpan="3" 
                                       FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Grid.Row="2" Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Сумма заказа" FontSize="20" Width="240"/>
                    <TextBlock Name="SumTB" FontSize="20" Width="240"/>
                </StackPanel>
                    <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Пункт выдачи" FontSize="20" Width="240"/>
                    <ComboBox Name="PickUpCB" Width="500">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding PickUpPointIndex}" Margin="0,0,5,0"/>
                                    <TextBlock Text="г. "/>
                                    <TextBlock Text="{Binding PickUpPointCity}" Margin="0,0,5,0"/>
                                    <TextBlock Text="ул. "/>
                                    <TextBlock Text="{Binding PickUpPointStreet}" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding PickUpPointHouse}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <Button Name="SaveBtn" Content="Сохранить" Click="SaveBtn_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
