<Window x:Class="Bayanov_Shoes.CheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Bayanov_Shoes"
        mc:Ignorable="d"
        Title="CheckWindow" Height="600" Width="600" FontFamily="Comic Sans MS">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Name="PrintArea" Grid.Row="0" BorderThickness="1" Padding="15" Background="White">
            <StackPanel>
                <TextBlock Text="ООО «41 размер»" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="ЧЕК ЗАКАЗА" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,15"/>

                <TextBlock Name="OrderNumTB" FontSize="16" HorizontalAlignment="Center" Margin="0,2"/>
                <TextBlock Name="OrderDateTB" FontSize="16" HorizontalAlignment="Center" Margin="0,2"/>
                <TextBlock Name="DeliveryDateTB" FontSize="16" HorizontalAlignment="Center" Margin="0,2"/>
                <TextBlock Name="DeliveryDaysTB" FontSize="16" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,2"/>
                <TextBlock Name="PickupPointTB" FontSize="16" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,2"/>
                <TextBlock Name="ClientTB" FontSize="16" HorizontalAlignment="Center" Margin="0,2"/>

                <Separator Margin="0,10"/>
                <TextBlock Text="Состав заказа:" FontWeight="Bold" FontSize="16" Margin="0,0,0,5"/>
                
                <ItemsControl Name="ProductsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding ProductName}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="{Binding ProductQuantity, StringFormat={}{0} шт.}" Margin="10,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Separator Margin="0,10"/>
                <TextBlock Name="TotalSumTB" FontSize="16" FontWeight="Bold" Margin="0,2" HorizontalAlignment="Right"/>

                <StackPanel>
                    <TextBlock Text="КОД ПОЛУЧЕНИЯ:" FontSize="16" HorizontalAlignment="Center" Margin="10"/>
                    <TextBlock Text="555" Name="OrderCodeTB" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
