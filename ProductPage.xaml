<Page x:Class="Bayanov_Shoes.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Bayanov_Shoes"
      mc:Ignorable="d" 
      d:DesignHeight="450"
      Title="ProductPage" FontFamily="Comic Sans MS">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="40 0 0 0" VerticalAlignment="Bottom">
            <TextBlock Text="Вы авторизованы как" Name="FIOTB" FontSize="20"/>
            <TextBlock Text="Роль:" Name="Role" FontSize="20"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="10,5,10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="30 0 0 0">
                <TextBlock Text="кол-во __ из __" Name="AmountCounter" VerticalAlignment="Center" FontSize="20"/>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="поиск по наименованию" HorizontalAlignment="Center" FontSize="20"/>
                <TextBox Name="TBox_Search" TextChanged="TBox_Search_TextChanged" Width="300" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,150,0">
                <RadioButton Name="RButton_Up" Checked="RButton_Up_Checked" Content="по возрастанию стоимости" GroupName="Sort" FontSize="20"/>
                <RadioButton Name="RButton_Down" Checked="RButton_Down_Checked"  Content="по убыванию стоимости" GroupName="Sort" FontSize="20"/>
            </StackPanel>

            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0 0 30 0">
                <TextBlock Text="фильтрация по скидке" FontSize="20"/>
                <ComboBox Name="ComboType" Width="150" SelectionChanged="ComboType_SelectionChanged" Margin="0 5 0 0">
                    <TextBlock>Все</TextBlock>
                    <TextBlock>от 0 до 9.99%</TextBlock>
                    <TextBlock>от 10 до 14.99%</TextBlock>
                    <TextBlock>от 15% и более</TextBlock>
                </ComboBox>
            </StackPanel>
        </Grid>

        <ListView Name="ProductListView" Margin="5" HorizontalContentAlignment="Stretch" Grid.Row="3">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Image Grid.Column="0" Grid.Row="0" Grid.RowSpan="4" Stretch="Uniform">
                                <Image.Source>
                                    <Binding Path="ProductPhotoPathFull"/>
                                </Image.Source>
                            </Image>
                            <TextBlock Style="{StaticResource MyStyle}" Text="{Binding ProductName}" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProductDescription}" TextWrapping="Wrap" Margin="0,5,0,0" VerticalAlignment="Top" FontSize="22"/>
                            <TextBlock Style="{StaticResource MyStyle}" Text="{Binding ProductManufacturer}" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Left"/>
                            <TextBlock Style="{StaticResource MyStyle}" Text="{Binding ProductCost, StringFormat='{}{0} руб.'}" Grid.Column="1" Grid.Row="3" HorizontalAlignment="Left"/>
                            <TextBlock Style="{StaticResource MyStyle}" Text="Скидка" Grid.Column="2" Grid.Row="0"/>
                            <TextBlock Text="{Binding ProductDiscountAmountInt, StringFormat='{}{0} %'}" Grid.Column="2" Grid.Row="1" Grid.RowSpan="3" 
                                       FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
